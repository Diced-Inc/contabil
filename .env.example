DATABASE_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserva: e-mails tratados como contador se a tabela contadores não responder (a fonte de verdade é a tabela)
ALLOWED_EMAILS=
ANTHROPIC_API_KEY=
IA_MODEL=claude-sonnet-5-5
# URL pública (link de recuperação de senha); vazio = origin da requisição
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
# Service role do Supabase (só servidor): convites e links de acesso. Vazio = convite não é enviado.
SUPABASE_SERVICE_ROLE_KEY=
# Resend: chave e remetente de domínio verificado, ex.: Bruno Contábil <avisos@dominio>. Vazio = e-mails não saem.
RESEND_API_KEY=
EMAIL_FROM=
# Responder-para dos e-mails (o cliente responde para cá, não para o remetente de avisos). Vazio = sem Reply-To.
EMAIL_REPLY_TO=
# Cloudflare Email Routing (tela E-mails do escritório). Token da conta com Account › Email Routing Addresses › Edit
# e Zone › Email Routing Rules › Edit. EMAIL_DOMINIO = domínio do escritório, ex.: dbcontador.com.br
CLOUDFLARE_EMAIL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
EMAIL_DOMINIO=
EMAIL_DESTINOS_OCULTOS=
